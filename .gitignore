# Build payload binaries/libs are distributed as GitHub release assets
# (files exceed git's 100 MB limit). Install them with:
#   env/scripts/fetch-builds.sh      (or they auto-fetch on first shim use)
env/builds/*/bin/
env/builds/*/lib/

# fetch cache
env/.cache/

# editor / OS noise
*.swp
*~
.DS_Store
