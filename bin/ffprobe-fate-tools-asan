#!/usr/bin/env bash
# ffmpeg-env shim: ffprobe @ variant fate-tools-asan
# Auto-generated by scripts/gen-shims.sh — regenerate instead of editing.
set -euo pipefail

_ffenv_self="${BASH_SOURCE[0]}"
while [ -L "$_ffenv_self" ]; do
  _ffenv_dir="$(cd -P "$(dirname "$_ffenv_self")" && pwd)"
  _ffenv_self="$(readlink "$_ffenv_self")"
  case "$_ffenv_self" in
    /*) ;;
    *) _ffenv_self="$_ffenv_dir/$_ffenv_self" ;;
  esac
done
FFENV_ROOT="$(cd -P "$(dirname "$_ffenv_self")/.." && pwd)"
FFENV_VARIANT="fate-tools-asan"
FFENV_TOOL="ffprobe"

_ffenv_bin="$FFENV_ROOT/builds/$FFENV_VARIANT/bin/$FFENV_TOOL"
if [ ! -x "$_ffenv_bin" ]; then
  if [ "${FFENV_AUTO_FETCH:-1}" = "1" ] && [ -x "$FFENV_ROOT/scripts/fetch-builds.sh" ]; then
    echo "ffenv: '$FFENV_TOOL' for variant '$FFENV_VARIANT' not installed; fetching build..." >&2
    "$FFENV_ROOT/scripts/fetch-builds.sh" "$FFENV_VARIANT" >&2 || true
  fi
fi
if [ ! -x "$_ffenv_bin" ]; then
  echo "ffenv: missing $_ffenv_bin" >&2
  echo "ffenv: install with: $FFENV_ROOT/scripts/fetch-builds.sh $FFENV_VARIANT" >&2
  exit 127
fi

_ffenv_lib="$FFENV_ROOT/builds/$FFENV_VARIANT/lib"
if [ -d "$_ffenv_lib" ]; then
  case ":${LD_LIBRARY_PATH:-}:" in
    *":$_ffenv_lib:"*) ;;
    *) export LD_LIBRARY_PATH="$_ffenv_lib${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}" ;;
  esac
fi
export ASAN_OPTIONS="${ASAN_OPTIONS:-detect_leaks=0:abort_on_error=1:halt_on_error=1:symbolize=1:allocator_may_return_null=1}"
export UBSAN_OPTIONS="${UBSAN_OPTIONS:-print_stacktrace=1:halt_on_error=1}"

exec "$_ffenv_bin" "$@"
